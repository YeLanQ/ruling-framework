{
  "name": "ruling-framework",
  "version": "0.1.0",
  "description": "A general adjudication-authority framework for LLM agents: models propose, the system rules, commands execute, gates verify.",
  "type": "module",
  "license": "Apache-2.0",
  "author": "YeLanQ",
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@11.24.0",
  "bin": {
    "ruling": "./dist/adapters/cli.js"
  },
  "exports": {
    ".": "./dist/index.js",
    "./core": "./dist/core/index.js",
    "./agent": "./dist/agent/index.js",
    "./packs": "./dist/packs/index.js"
  },
  "files": [
    "dist",
    "docs",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "demo": "tsx src/demo/opc-demo.ts",
    "demo:industrial": "tsx src/demo/industrial-demo.ts",
    "ruling": "tsx src/adapters/cli.ts",
    "lint": "eslint .",
    "lint:semantic": "eslint . --config eslint.config.semantic.mjs",
    "check:syntax": "node scripts/check-syntax.mjs",
    "check:eol": "node scripts/check-eol.mjs",
    "changelog": "node scripts/update-changelog.mjs",
    "audit": "pnpm audit --audit-level high",
    "verify": "pnpm typecheck && pnpm test && pnpm demo && pnpm demo:industrial",
    "gate": "pnpm check:eol && pnpm check:syntax && pnpm typecheck && pnpm lint:semantic && pnpm lint && pnpm audit && pnpm test && pnpm build && pnpm demo && pnpm demo:industrial"
  },
  "devDependencies": {
    "@types/node": "^22.13.1",
    "eslint": "^10.13.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.71.2",
    "vitest": "^4.1.11"
  }
}

  "knowledge": [
    {
      "id": "seed:safety-params",
      "kind": "seed",
      "title": "安全关键参数是红灯",
      "summary": "壁厚、安全系数、材料等级、额定载荷等参数变更不得由 Agent 执行",
      "body": "安全关键参数与认证参数属于动态红灯。即使任务已批准，也必须由具备资质的人在 CAD/PLM 系统内修改并签核。",
      "tags": [
        "safety",
        "red-line"
      ],
      "uses": [
        "design.set_param",
        "safety.signoff"
      ]
    },
    {
      "id": "seed:format-locks",
      "kind": "seed",
      "title": "格式锁",
      "summary": "CAD 交换格式走 cad.import，PDF 走 report.export，表格走 bom.update",
      "body": "通用文本写入不得直接写 .step/.stp/.iges/.igs/.stl/.3mf、.pdf、.csv/.xlsx。它们分别由 cad.import、report.export、bom.update 通道管理。",
      "tags": [
        "format",
        "boundary"
      ],
      "uses": [
        "cad.import",
        "report.export",
        "bom.update"
      ]
    },
    {
      "id": "seed:revision-provenance",
      "kind": "seed",
      "title": "版本与溯源",
      "summary": "每次参数/BOM/附件变更都记录 before/after 哈希",
      "body": "设计变更必须写入 revision 与 provenance：时间、动作、执行者角色、修订号、变更前后哈希。导出报告时带上溯源。",
      "tags": [
        "provenance",
        "revision"
      ],
      "uses": [
        "design.create_revision",
        "design.set_param",
        "bom.update",
        "design.attach_asset"
      ]
    },
    {
      "id": "seed:dfm-advisory",
      "kind": "seed",
      "title": "DFM 只是建议",
      "summary": "可制造性检查不能替代发布签核",
      "body": "dfm.check 是只读建议，不构成发布授权。发布与安全签核是红灯，只能由人完成。",
      "tags": [
        "dfm",
        "release"
      ],
      "uses": [
        "dfm.check",
        "design.release"
      ]
    }
  ]

{
  "id": "industrial-design",
  "name": "Industrial Design",
  "version": "0.1.0",
  "description": "Industrial/product design reference pack: revisions and provenance, format locks, safety-critical parameters are red.",
  "roles": [
    "designer",
    "engineer",
    "reviewer",
    "owner"
  ],
  "defaultRole": "designer",
  "approval": {
    "ttlMs": 900000,
    "defaultRoles": [
      "owner"
    ],
    "byGroup": {
      "release": [
        "reviewer",
        "owner"
      ]
    }
  },
  "grants": {
    "designer": [
      "read",
      "write",
      "analyze",
      "knowledge"
    ],
    "engineer": [
      "read",
      "write",
      "analyze",
      "knowledge"
    ],
    "reviewer": [
      "read",
      "analyze"
    ],
    "owner": [
      "*"
    ]
  },
  "formatLocks": [
    {
      "extensions": [
        ".step",
        ".stp",
        ".iges",
        ".igs",
        ".stl",
        ".3mf"
      ],
      "channel": "cad.import",
      "reason": "CAD 二进制/交换格式必须走导入通道"
    },
    {
      "extensions": [
        ".pdf"
      ],
      "channel": "report.export",
      "reason": "交付 PDF 必须由导出通道生成"
    },
    {
      "extensions": [
        ".csv",
        ".xlsx"
      ],
      "channel": "bom.update",
      "reason": "BOM 表格必须由 BOM 通道更新"
    }
  ],
  "actions": [
    {
      "id": "design.list",

        "列出设计",
        "设计列表",
        "list designs"
      ],
      "group": "read",
      "zone": "green",
      "speedBudgetMs": 2000,
      "energyWeight": 1
    },
    {
      "id": "design.read",
      "title": "读取设计对象",

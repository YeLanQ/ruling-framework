        "支付",
        "payment"
      ],
      "group": "external",
      "zone": "red",
      "speedBudgetMs": 15000,
      "energyWeight": 3
    },
    {
      "id": "workspace.delete",
      "title": "删除工作区内容",
      "description": "删除文件或目录（破坏性动作）",
      "keywords": [
        "删除",
        "清除",
        "delete"
      ],
      "group": "destructive",
      "zone": "red",
      "speedBudgetMs": 5000,
      "energyWeight": 3,
      "inputSchema": {
        "type": "object",

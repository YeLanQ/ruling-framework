  "knowledge": [
    {
      "id": "seed:delivery",
      "kind": "seed",
      "title": "交付闭环",
      "summary": "写文档 → 构建 → 导出报告 → 检查审计",
      "body": "交付不是一段说明，而是可打开、可验收的产物。顺序：写文档，构建项目，导出报告，最后检查审计记录。",
      "tags": [
        "delivery",
        "workflow"
      ],
      "uses": [
        "doc.write",
        "project.build",
        "report.export"
      ]
    },
    {
      "id": "seed:read-first",
      "kind": "seed",
      "title": "先读后写",
      "summary": "写之前先读取现状，避免覆盖未知内容",
      "body": "任何写操作之前，先列出目录并读取目标文件。读操作是绿灯，不需要批准。",
      "tags": [
        "write",
        "safety"
      ],
      "uses": [
        "workspace.list",
        "workspace.read",
        "doc.read"
      ]
    },
    {
      "id": "seed:red-lines",
      "kind": "seed",
      "title": "OPC 红灯",
      "summary": "发布、付款、删除不可自主执行",
      "body": "对外发布、付款与删除属于红灯，批准也不能放行。它们必须由人直接在框架外完成。",
      "tags": [
        "red-line",
        "safety"
      ],
      "uses": [
        "project.publish",
        "payment.execute",
        "workspace.delete"
      ]
    }
  ]
}

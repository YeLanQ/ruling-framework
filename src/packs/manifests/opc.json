        "lesson"
      ],
      "group": "knowledge",
      "zone": "yellow",
      "speedBudgetMs": 5000,
      "energyWeight": 3,
      "inputSchema": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "body": {
            "type": "string",
            "minLength": 1
          },
          "summary": {
            "type": "string"
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "uses": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "namespace": {
            "type": "string"
          },
          "domain": {
            "type": "string"
          },
          "aliases": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "status": {
            "type": "string",
            "enum": [
              "draft",
              "active",
              "deprecated"
            ]
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "supersedes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "contradicts": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "id",
          "title",
          "body"
        ],
        "additionalProperties": false
      }
    },
    {
      "id": "knowledge.merge",
      "title": "合并知识",
      "description": "把重复单元合并到规范单元，合并别名/标签/推荐动作并废弃重复项",
      "keywords": [
        "合并知识",
        "去重",
        "merge"
      ],
      "group": "knowledge",
      "zone": "yellow",
      "speedBudgetMs": 5000,
      "energyWeight": 3,
      "inputSchema": {
        "type": "object",
        "properties": {
          "canonicalId": {
            "type": "string",
            "minLength": 1
          },
          "duplicateIds": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "reason": {
            "type": "string"
          }
        },
        "required": [
          "canonicalId",
          "duplicateIds"
        ],
        "additionalProperties": false
      }
    },
    {
      "id": "knowledge.deprecate",
      "title": "废弃知识",

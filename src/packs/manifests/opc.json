{
  "id": "opc",
  "name": "OPC / One Person Company",
  "version": "0.1.0",
  "description": "One-person company reference pack: read freely, approve writes, never publish or pay automatically.",
  "roles": [
    "owner"
  ],
  "defaultRole": "owner",
  "approval": {
    "ttlMs": 600000,
    "defaultRoles": [
      "owner"
    ]
  },
  "grants": {
    "owner": [
      "*"
    ]
  },
  "formatLocks": [
    {
      "extensions": [
        ".pdf"
      ],
      "channel": "report.export",
      "reason": "交付 PDF 必须由导出通道生成"
    }
  ],
  "actions": [
    {
      "id": "workspace.list",
      "title": "列出工作区",
      "description": "列出工作区目录内容（只读）",
      "keywords": [
        "列出文件",
        "查看工作区",
        "目录",
        "list",
        "files"
      ],
      "group": "read",
      "zone": "green",
      "speedBudgetMs": 2000,
      "energyWeight": 1,
      "inputSchema": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    {
      "id": "workspace.read",
      "title": "读取工作区文件",
      "description": "读取工作区内的文本文件（只读）",
      "keywords": [
        "读取文件",
        "查看文件",
        "read file"
      ],
      "group": "read",
      "zone": "green",
      "speedBudgetMs": 2000,
      "energyWeight": 1,
      "inputSchema": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string"
          }
        },
        "required": [
          "path"
        ],
        "additionalProperties": false
      }
    },
    {
      "id": "doc.read",
      "title": "读取文档",
      "description": "读取交付文档内容（只读）",
      "keywords": [
        "读取文档",
        "查看文档",
        "read doc"
      ],
      "group": "read",
      "zone": "green",
      "speedBudgetMs": 2000,
      "energyWeight": 1,
      "inputSchema": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string"
          }
        },
        "required": [
          "path"
        ],
        "additionalProperties": false
      }
    },
    {
      "id": "doc.write",
      "title": "写入文档",
      "description": "写入或覆盖工作区内的文本文档",
      "keywords": [
        "写文档",
        "写入",
        "保存文档",
        "write doc"
      ],
      "group": "write",
      "zone": "yellow",
      "speedBudgetMs": 5000,
      "energyWeight": 3,
      "inputSchema": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "content": {
            "type": "string"
          }
        },
        "required": [
          "path",
          "content"
        ],
        "additionalProperties": false
      }
    },
    {
      "id": "asset.import",
      "title": "导入资产",
      "description": "把文本资产导入工作区（二进制资产需真实导入通道）",
      "keywords": [
        "导入资产",
        "素材",
        "import asset"
      ],
      "group": "write",
      "zone": "yellow",
      "speedBudgetMs": 5000,
      "energyWeight": 3,
      "inputSchema": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "content": {
            "type": "string"
          }
        },
        "required": [
          "path",
          "content"
        ],
        "additionalProperties": false
      }
    },
    {
      "id": "project.build",
      "title": "构建项目",
      "description": "生成交付构建清单",
      "keywords": [
        "构建",
        "打包",
        "build"
      ],
      "group": "build",
      "zone": "yellow",
      "speedBudgetMs": 120000,
      "energyWeight": 3,
      "inputSchema": {
        "type": "object",
        "properties": {
          "output": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    {
      "id": "knowledge.add",
      "title": "登记知识",
      "description": "把一条经验或标准作业程序写入知识层",
      "keywords": [
        "记住",
        "登记知识",
        "经验",
        "knowledge"
      ],
      "group": "knowledge",
      "zone": "yellow",
      "speedBudgetMs": 5000,
      "energyWeight": 3,
      "inputSchema": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "body": {
            "type": "string",
            "minLength": 1
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "summary": {
            "type": "string"
          },
          "uses": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "namespace": {
            "type": "string"
          },
          "domain": {
            "type": "string"
          },
          "aliases": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "status": {
            "type": "string",
            "enum": [
              "draft",
              "active",
              "deprecated"
            ]
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "supersedes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "contradicts": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "id",
          "title",
          "body"
        ],
        "additionalProperties": false
      }
    },
    {
      "id": "lesson.add",
      "title": "登记失败教训",
      "description": "把一次失败的原因与规避路径写入失败教训库",
      "keywords": [
        "教训",
        "失败",

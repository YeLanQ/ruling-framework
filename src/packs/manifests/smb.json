  "knowledge": [
    {
      "id": "seed:roles",
      "kind": "seed",
      "title": "角色与能力组",
      "summary": "viewer 只读；editor 写与构建；reviewer 评审；owner 全量",
      "body": "能力组是源头授权单位。viewer 只有 read；editor 有 read/write/build/deliver；reviewer 有 read/review；owner 拥有全部能力。",
      "tags": [
        "roles",
        "grants"
      ]
    },
    {
      "id": "seed:dual-approval",
      "kind": "seed",
      "title": "发布双批准",
      "summary": "release 组需要 reviewer 与 owner 两个不同角色批准",
      "body": "发布类动作的审批策略要求 reviewer 与 owner 分别批准；同一角色重复批准不计数。",
      "tags": [
        "approval",
        "release"
      ],
      "uses": [
        "release.prepare",
        "release.publish"
      ]
    },
    {
      "id": "seed:permission-change",
      "kind": "seed",
      "title": "权限变更是红灯",
      "summary": "角色授予不能由 Agent 自主执行",
      "body": "role.grant 属于红灯：权限体系的变化必须由人直接在管理面完成，模型与批准会话都不能放行。",
      "tags": [
        "red-line",
        "admin"
      ],
      "uses": [
        "role.grant"
      ]
    }
  ]

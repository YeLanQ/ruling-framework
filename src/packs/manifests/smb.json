{
  "id": "smb",
  "name": "Small Business",
  "version": "0.1.0",
  "description": "Small-team reference pack: role-based source grants and dual approval for releases.",
  "roles": [
    "owner",
    "editor",
    "reviewer",
    "viewer"
  ],
  "defaultRole": "editor",
  "approval": {
    "ttlMs": 600000,
    "defaultRoles": [
      "owner"
    ],
    "byGroup": {
      "release": [
        "reviewer",
        "owner"
      ]
    }
  },
  "grants": {
    "owner": [
      "*"
    ],
    "editor": [
      "read",
      "write",
      "build",
      "deliver",
      "release",
      "knowledge"
    ],
    "reviewer": [
      "read",
      "review"
    ],
    "viewer": [
      "read"
    ]
  },
  "formatLocks": [
    {
      "extensions": [
        ".pdf"
      ],
      "channel": "report.export",
      "reason": "交付 PDF 必须由导出通道生成"
    }
  ],
  "actions": [
    {
